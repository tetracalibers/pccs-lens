<script>
  import BernsteinBasisDemo from '$lib/demo/threejs/modeling/bezier-curve-surface/bernstein-basis/BernsteinBasisDemo.svelte'
  import CanvasWrapper from '$lib/demo/CanvasWrapper.svelte'
  import ControlPolygonDemo from '$lib/demo/threejs/modeling/bezier-curve-surface/control-polygon/ControlPolygonDemo.svelte'
  import LinearInterpolationDemo from '$lib/demo/threejs/modeling/bezier-curve-surface/linear-interpolation/LinearInterpolationDemo.svelte'
  import QuadraticBezierDemo from '$lib/demo/threejs/modeling/bezier-curve-surface/quadratic-bezier/QuadraticBezierDemo.svelte'
