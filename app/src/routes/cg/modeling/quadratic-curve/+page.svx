  import ConicSectionDemo from '$lib/demo/threejs/modeling/quadratic-curve/conic-section/ConicSectionDemo.svelte'
  import FocusDirectrixDemo from '$lib/demo/threejs/modeling/quadratic-curve/focus-directrix/FocusDirectrixDemo.svelte'
  import GeneratrixRevolutionDemo from '$lib/demo/threejs/modeling/quadratic-curve/generatrix-revolution/GeneratrixRevolutionDemo.svelte'
  import HyperbolaAsymptotesDemo from '$lib/demo/threejs/modeling/quadratic-curve/hyperbola-asymptotes/HyperbolaAsymptotesDemo.svelte'
