  import SincInterpolationDemo from '$lib/demo/threejs/basics/sampling-theorem-and-interpolation/sinc-interpolation/SincInterpolationDemo.svelte'
  import SamplingTheoremDemo from '$lib/demo/threejs/basics/sampling-theorem-and-interpolation/sampling-theorem/SamplingTheoremDemo.svelte'
