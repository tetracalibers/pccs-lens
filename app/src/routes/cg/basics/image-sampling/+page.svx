  import MoirePatternDemo from '$lib/demo/threejs/basics/image-sampling/moire-pattern/MoirePatternDemo.svelte'
  import SamplingTheoremDemo from '$lib/demo/threejs/basics/image-sampling/sampling-theorem/SamplingTheoremDemo.svelte'
