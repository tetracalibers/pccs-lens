  import SmallBumpDiffraction from "$lib/demo/color/light-phenomena/SmallBumpDiffraction.svelte"
  import SoapBubbleInterferenceDemo from "$lib/demo/threejs/color/soap-bubble-interference/SoapBubbleInterferenceDemo.svelte"
